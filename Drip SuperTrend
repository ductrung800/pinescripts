// ── Helpers: text size + theme colours ───────────────────────
f_size(string sz) =>
    sz == "Tiny" ? size.tiny : sz == "Small" ? size.small : sz == "Normal" ? size.normal : size.large

sz_tbl = f_size(i_tbl_size)
sz_lbl = f_size(i_lbl_size)
sz_lvl = f_size(i_lvl_size)

is_dark = i_theme == "Dark"
c_ink   = is_dark ? color.white : color.black
c_bg    = is_dark ? color.new(#080808, 5) : color.new(#f4f6f8, 3)
c_hdr   = is_dark ? color.white  : #101418
c_txt   = is_dark ? color.silver : #37474f
c_dim   = is_dark ? color.gray   : #607d8b
c_warn  = is_dark ? color.orange : #e65100
c_cool  = is_dark ? color.aqua   : #00838f

// ═══════════════════════════════════════════════════════════════
//   ADAPTIVE LAYER
// ═══════════════════════════════════════════════════════════════

atr = ta.atr(i_len)

// ── 1. KAUFMAN EFFICIENCY RATIO ──────────────────────────────
// Net price displacement divided by total path traveled.
// A perfectly trending market scores 1.0.
// A market going nowhere despite lots of movement scores near 0.0.

net_move   = math.abs(close - close[i_er_len])
var float total_path = 0.0
total_path := 0.0
for i = 0 to i_er_len - 1
    total_path += math.abs(close[i] - close[i + 1])
er        = total_path > 0 ? net_move / total_path : 0.0
er_smooth = ta.ema(er, 3)

// ── 2. VOLATILITY REGIME ─────────────────────────────────────
// Current ATR expressed as a ratio to its 50-bar baseline.
// > 1.2 : elevated, the factor widens
// < 0.8 : compressed, the factor tightens
// Clamped to 0.75 - 1.40 and used to scale the factor below.

atr_baseline = ta.sma(atr, 50)
vol_ratio    = atr_baseline > 0 ? atr / atr_baseline : 1.0
vol_regime   = math.max(math.min(vol_ratio, 1.40), 0.75)

// ── 3. ADAPTIVE FACTOR ───────────────────────────────────────
// The SuperTrend multiplier is scaled by the volatility regime.
// The band widens when volatility is elevated and tightens when
// volatility is compressed.

adaptive_factor = i_factor * vol_regime

// ── 4. ER-DRIVEN ADAPTIVE CONFIRMATION ───────────────────────
// Low ER (chop): require more bars before a flip is confirmed.
// High ER (trend): require fewer.

adaptive_confirm = er_smooth < 0.25 ? math.max(i_confirm + 2, 4) :
                   er_smooth < 0.45 ? i_confirm + 1               :
                   er_smooth < 0.65 ? i_confirm                   :
                                      math.max(i_confirm - 1, 1)

// ── 5. FLIP QUALITY SCORE (0–100) ────────────────────────────
// Calculated at every flip. Three weighted components:
//   50% — Efficiency (ER): is the market actually trending?
//   30% — Volatility normality: is vol in a healthy range?
//         (peaks at vol_ratio=1.0, falls off at extremes)
//   20% — 5-bar momentum: is price actually moving at the flip?
//
// Higher scores mean the flip happened in cleaner conditions.
// Grades: A = 70 and above, B = 50 to 69, C = below 50.

price_mom_pct = math.abs(ta.roc(close, 5))
atr_pct       = close > 0 ? atr / close * 100 : 0.0
mom_norm      = atr_pct > 0 ? math.min(price_mom_pct / (atr_pct * 2), 1.0) : 0.0

vol_score     = math.max(1.0 - math.abs(1.0 - vol_ratio), 0.0)
quality_raw   = er_smooth * 0.50 + vol_score * 0.30 + mom_norm * 0.20
quality_pct   = math.round(quality_raw * 100)

quality_grade = quality_pct >= 70 ? "A" :quality_pct >= 50 ? "B" : "C"

// ── 6. ADX / DI (dashboard only, does not affect signals) ────
[di_plus, di_minus, adx_val] = ta.dmi(i_adx_len, i_adx_len)

// ═══════════════════════════════════════════════════════════════
//   MANUAL SUPERTREND WITH ADAPTIVE FACTOR
//   ta.supertrend() only accepts a simple float, so we implement
//   the identical algorithm manually to accept our series factor.
// ═══════════════════════════════════════════════════════════════

upper_basic = hl2 + adaptive_factor * atr
lower_basic = hl2 - adaptive_factor * atr

var float upper_band = na
var float lower_band = na

upper_band := na(upper_band[1]) ? upper_basic : (upper_basic < upper_band[1] or close[1] > upper_band[1] ? upper_basic : upper_band[1])
lower_band := na(lower_band[1]) ? lower_basic : (lower_basic > lower_band[1] or close[1] < lower_band[1] ? lower_basic : lower_band[1])

var int trend_dir = 1
trend_dir := na(trend_dir[1]) ? 1 : trend_dir[1] ==  1 ? (close < lower_band ? -1 :  1) :(close > upper_band  ?  1 : -1)

st   = trend_dir ==  1 ? lower_band : upper_band
bull = trend_dir ==  1

