haber_dry_ratio = input.float(0.85, 'Dry-Up Volume Ratio', minval=0.30, maxval=1.20, step=0.05, group=grp_haber_quality)
haber_fresh_bars = input.int(3, 'Recent CP Break Age', minval=0, maxval=20, group=grp_haber_quality)
