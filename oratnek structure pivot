// CORE CALCULATIONS — STAGE ANALYSIS

// ═══════════════════════════════════════════════════════════════════════════════

ema10_st    = ta.ema(close, lenEMA10)

sma20_st    = ta.sma(close, lenSMA20)

sma50_st    = ta.sma(close, lenSMA50_st)

atr_st      = ta.atr(lenATR_st)

atrx_st     = (close - sma50_st) / atr_st

maSpread_st = math.max(math.max(ema10_st, sma20_st), sma50_st) - math.min(math.min(ema10_st, sma20_st), sma50_st)

ema10Up_st = ema10_st > ema10_st[1]

sma20Up_st = sma20_st > sma20_st[1]

sma50Up_st = sma50_st > sma50_st[1]

upAlign_st   = close > ema10_st and ema10_st > sma20_st and sma20_st > sma50_st and ema10Up_st and sma20Up_st and sma50Up_st

downAlign_st = close < ema10_st and ema10_st < sma20_st and sma20_st < sma50_st and not ema10Up_st and not sma20Up_st and not sma50Up_st

breakout_st  = close > ta.highest(high, boLookback)[1]

breakdown_st = close < ta.lowest(low,  boLookback)[1]

extBull_st   = upAlign_st   and atrx_st >= 7

extBear_st   = downAlign_st and atrx_st <= -7

basing_st  = math.abs(close - sma50_st) <= basingBandATR * atr_st and maSpread_st <= maCompressionATR * atr_st

meanRev_st = not upAlign_st and not downAlign_st and not basing_st and close >= sma20_st and ema10_st >= sma20_st

fadeA_st   = not extBull_st and close >= sma50_st and ((upAlign_st and (close < ema10_st or not ema10Up_st)) or (ema10_st >= sma20_st and close < ema10_st))

fadeB_st   = not extBear_st and close >= sma50_st and ema10_st < sma20_st

ST_1A=1, ST_1B=2, ST_2A=3, ST_2B=4, ST_2C=5, ST_3A=6, ST_3B=7, ST_4A=8, ST_4B=9, ST_4C=10

stage = if extBull_st

    ST_2C

else if extBear_st

    ST_4C

else if upAlign_st

    breakout_st ? ST_2B : ST_2A

else if downAlign_st

    breakdown_st ? ST_4B : ST_4A

else if fadeB_st

    ST_3B

else if fadeA_st

    ST_3A

else if meanRev_st

    ST_1B

else

    ST_1A

stageName = if stage == ST_1A

    "1A Basing"

else if stage == ST_1B

    "1B Mean Reversion"

else if stage == ST_2A

    "2A Bullish Trend"

else if stage == ST_2B

