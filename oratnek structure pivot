grp_haber_pad = 'Haber CP · Launchpad'
haber_pad_mode = input.string('Short 10/21/23', 'Launchpad MA Set', options=['Short 10/21/23','Full 10/21/23/50/65/200'], group=grp_haber_pad)
haber_max_ma_spread = input.float(3.0, 'Max MA Bunch Spread (%)', minval=0.25, maxval=10.0, step=0.25, group=grp_haber_pad)
haber_ma_slope_lb = input.int(5, 'MA Turning-Up Lookback', minval=1, maxval=20, group=grp_haber_pad)
