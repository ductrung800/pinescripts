// Base-location context for the ASP 2nd Pivot.
haber_base_high = ta.highest(high, haber_base_len)
haber_base_low = ta.lowest(low, haber_base_len)
haber_base_range = haber_base_high - haber_base_low
haber_cp_pos = haber_has_asp_setup and haber_base_range > 0.0 ? (haber_cp - haber_base_low) / haber_base_range * 100.0 : na
haber_lower_half = haber_has_asp_setup and not na(haber_cp_pos) and haber_cp_pos <= haber_lower_half_max
haber_dist_cp = haber_has_asp_setup and haber_cp > 0.0 ? (haber_cp - close) / haber_cp * 100.0 : na
haber_approach = haber_has_asp_setup and not na(haber_dist_cp) and haber_dist_cp >= -haber_max_break_ext and haber_dist_cp <= haber_approach_pct

// Independent declining-tops line. This is a HABER governor, not ASP authority.
haber_major_ph = ta.pivothigh(high, haber_trend_len, haber_trend_len)
var float haber_prev_top = na
var int haber_prev_top_bar = na
var float haber_t1 = na
var float haber_t2 = na
var int haber_x1 = na
var int haber_x2 = na
var line haber_line = na
if not na(haber_major_ph)
    haber_major_bar = bar_index - haber_trend_len
    if not na(haber_prev_top) and haber_major_ph < haber_prev_top
        haber_t1 := haber_prev_top
        haber_x1 := haber_prev_top_bar
        haber_t2 := haber_major_ph
        haber_x2 := haber_major_bar
        line.delete(haber_line)
        if haber_show_trendline
            haber_line := line.new(haber_x1, haber_t1, haber_x2, haber_t2, extend=extend.right, color=color.new(color.fuchsia, 15), width=2)
    haber_prev_top := haber_major_ph
    haber_prev_top_bar := haber_major_bar
haber_trend_valid = not na(haber_x1) and not na(haber_x2) and haber_x2 > haber_x1 and haber_t2 < haber_t1
haber_trend_slope = haber_trend_valid ? (haber_t2 - haber_t1) / (haber_x2 - haber_x1) : na
haber_trend_value = haber_trend_valid ? haber_t2 + haber_trend_slope * (bar_index - haber_x2) : na
haber_trend_cleared = not haber_trend_valid or close > haber_trend_value
haber_trend_ok = not haber_block_below_trend or haber_trend_cleared
haber_confluence = haber_has_asp_setup and haber_trend_valid and not na(haber_trend_value) and haber_cp > 0.0 and math.abs(haber_cp - haber_trend_value) / haber_cp * 100.0 <= haber_confluence_tol

// Launchpad underneath price.
haber_sma10 = ta.sma(close, 10)
haber_sma21 = ta.sma(close, 21)
haber_ema23 = ta.ema(close, 23)
haber_sma50 = ta.sma(close, 50)
haber_ema65 = ta.ema(close, 65)
haber_sma200 = ta.sma(close, 200)
haber_short_max = math.max(haber_sma10, math.max(haber_sma21, haber_ema23))
haber_short_min = math.min(haber_sma10, math.min(haber_sma21, haber_ema23))
haber_full_max_1 = math.max(haber_short_max, math.max(haber_sma50, haber_ema65))
haber_full_max = math.max(haber_full_max_1, haber_sma200)
haber_full_min_1 = math.min(haber_short_min, math.min(haber_sma50, haber_ema65))
haber_full_min = math.min(haber_full_min_1, haber_sma200)
haber_use_full = haber_pad_mode == 'Full 10/21/23/50/65/200'
haber_pad_max = haber_use_full ? haber_full_max : haber_short_max
haber_pad_min = haber_use_full ? haber_full_min : haber_short_min
haber_pad_ready = haber_use_full ? not na(haber_sma200) : not na(haber_ema23)
haber_ma_spread = haber_pad_ready and close > 0.0 ? (haber_pad_max - haber_pad_min) / close * 100.0 : na
haber_pad_beneath = haber_pad_ready and haber_pad_max < close
haber_short_up = haber_sma10 > haber_sma10[haber_ma_slope_lb] and haber_sma21 > haber_sma21[haber_ma_slope_lb] and haber_ema23 > haber_ema23[haber_ma_slope_lb]
haber_full_up_count = 0
haber_full_up_count += haber_sma10 > haber_sma10[haber_ma_slope_lb] ? 1 : 0
haber_full_up_count += haber_sma21 > haber_sma21[haber_ma_slope_lb] ? 1 : 0
haber_full_up_count += haber_ema23 > haber_ema23[haber_ma_slope_lb] ? 1 : 0
haber_full_up_count += haber_sma50 > haber_sma50[haber_ma_slope_lb] ? 1 : 0
haber_full_up_count += haber_ema65 > haber_ema65[haber_ma_slope_lb] ? 1 : 0
haber_full_up_count += haber_sma200 > haber_sma200[haber_ma_slope_lb] ? 1 : 0
haber_pad_up = haber_use_full ? haber_full_up_count >= 4 : haber_short_up
haber_launchpad = haber_pad_ready and not na(haber_ma_spread) and haber_ma_spread <= haber_max_ma_spread and haber_pad_beneath and haber_pad_up
haber_pad_ok = not haber_require_pad or haber_launchpad

// Tightness + volume dry-up + break volume.
haber_vol_avg = ta.sma(volume, haber_vol_len)
haber_prior_vol_avg = haber_vol_avg[1]
haber_rvol = haber_prior_vol_avg > 0.0 ? volume / haber_prior_vol_avg : 0.0
haber_vol_pickup = haber_rvol >= haber_break_rvol
haber_tr = ta.tr(true)
haber_fast_range = ta.sma(haber_tr, haber_tight_fast)
haber_slow_range = ta.sma(haber_tr, haber_tight_slow)
haber_range_tight = haber_slow_range > 0.0 and haber_fast_range / haber_slow_range <= haber_tight_ratio
haber_fast_vol = ta.sma(volume, haber_tight_fast)
haber_slow_vol = ta.sma(volume, haber_tight_slow)
haber_volume_dry = haber_slow_vol > 0.0 and haber_fast_vol / haber_slow_vol <= haber_dry_ratio
haber_tight_dry = haber_range_tight and haber_volume_dry

