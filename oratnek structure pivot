// CORE CALCULATIONS — ATR / MAs

// ═══════════════════════════════════════════════════════════════════════════════

atr  = ta.atr(atr_length)

atr2 = (ta.atr(atr_length) / close) * 100

// Four independent MA series. Defaults: SMA50 / EMA21 / EMA9 / SMA200.
ma  = maType  == 'SMA' ? ta.sma(close, maLen)  : ta.ema(close, maLen)

ma2 = maType2 == 'EMA' ? ta.ema(close, maLen2) : ta.sma(close, maLen2)

