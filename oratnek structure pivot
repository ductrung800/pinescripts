stagePosition = if stage == ST_1A or stage == ST_1B

    "BASING"

else if stage == ST_2A or stage == ST_2B or stage == ST_2C

    "ADVANCING"

else if stage == ST_3A or stage == ST_3B

    "DISTRIBUTION"

else

