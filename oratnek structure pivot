haber_max_break_ext = input.float(3.0, 'Fresh Break Max Extension (%)', minval=0.5, maxval=10.0, step=0.25, group=grp_haber)
haber_trend_len = input.int(8, 'Declining-Tops Pivot Length', minval=4, maxval=20, group=grp_haber)
