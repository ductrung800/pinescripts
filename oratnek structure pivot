ma4 = maType4 == 'SMA' ? ta.sma(close, maLen4) : ta.ema(close, maLen4)

percent_above_ema21 = (close - ma2) / ma2 * 100

percent_above_ema9  = (close - ma3) / ma3 * 100

atrRatio          = atr / close

extATR2           = (close - ma2) / atr

extRatio2         = close / ma2 - 1.0

extATRasPctOfATR2 = atrRatio == 0 ? na : extRatio2 / atrRatio

extATR3           = (close - ma3) / atr

extRatio3         = close / ma3 - 1.0

extATRasPctOfATR3 = atrRatio == 0 ? na : extRatio3 / atrRatio

lowVma  = low - ma

highVma  = ma  - high

rsiPos  = lowVma  / atr

rsiNeg  = highVma  / atr

lowVma2 = low - ma2

highVma2 = ma2 - high

rsiPos2 = lowVma2 / atr

rsiNeg2 = highVma2 / atr

lowVma3 = low - ma3

highVma3 = ma3 - high

rsiPos3 = lowVma3 / atr

rsiNeg3 = highVma3 / atr

posCol  = rsiPos  >= extMult ? extUpCol : rsiPos  >= 0 ? upCol : rsiPos  < 0 and rsiNeg  < 0 ? upCol : color.new(atrx_themeTextCol, 100)

negCol  = rsiNeg  >= extMult ? extDnCol : rsiNeg  > 0 ? dnCol : rsiPos  < 0 and rsiNeg  < 0 ? dnCol : color.new(atrx_themeTextCol, 100)

posCol2 = rsiPos2 >= extMult ? extUpCol : rsiPos2 >= 0 ? upCol : rsiPos2 < 0 and rsiNeg2 < 0 ? upCol : color.new(atrx_themeTextCol, 100)

negCol2 = rsiNeg2 >= extMult ? extDnCol : rsiNeg2 > 0 ? dnCol : rsiPos2 < 0 and rsiNeg2 < 0 ? dnCol : color.new(atrx_themeTextCol, 100)

posCol3 = rsiPos3 >= extMult ? extUpCol : rsiPos3 >= 0 ? upCol : rsiPos3 < 0 and rsiNeg3 < 0 ? upCol : color.new(atrx_themeTextCol, 100)

negCol3 = rsiNeg3 >= extMult ? extDnCol : rsiNeg3 > 0 ? dnCol : rsiPos3 < 0 and rsiNeg3 < 0 ? dnCol : color.new(atrx_themeTextCol, 100)

// SMA200 gets its own distance/color state.
// Previously the SMA200 plot reused SMA50's ma/posCol/negCol logic.
lowVma4  = low - ma4
highVma4 = ma4 - high
rsiPos4  = lowVma4 / atr
rsiNeg4  = highVma4 / atr

posCol4 = rsiPos4 >= extMult ? extUpCol : rsiPos4 >= 0 ? upCol : rsiPos4 < 0 and rsiNeg4 < 0 ? upCol : color.new(atrx_themeTextCol, 100)
negCol4 = rsiNeg4 >= extMult ? extDnCol : rsiNeg4 > 0 ? dnCol : rsiPos4 < 0 and rsiNeg4 < 0 ? dnCol : color.new(atrx_themeTextCol, 100)

