// --- Method ---

method update(PivotState st) =>

    p = st.is_long ? ta.pivotlow(low, st.len, st.len) : ta.pivothigh(high, st.len, st.len)

    if not na(p)

        setup_cond = false

        if not na(st.curr_p)

            if st.is_long

                if p > st.curr_p

                    setup_cond := true

            else

                if p < st.curr_p

                    setup_cond := true

        st.prev_p    := st.curr_p

        st.prev_idx  := st.curr_idx

        st.curr_p    := p

        st.curr_idx  := bar_index - st.len

        st.is_setup  := setup_cond

        st.break_val := na

        st.break_idx := na

        if setup_cond and not na(st.prev_idx)

            best_val = st.is_long ? 0.0 : 1000000.0

            best_idx = -1

            start_s = st.prev_idx + 1

            end_s = st.curr_idx - 1

            if end_s >= start_s

                for i = start_s to end_s

                    v = st.is_long ? high[bar_index - i] : low[bar_index - i]

                    if st.is_long

                        if v > best_val

                            best_val := v

                            best_idx := i

                    else

                        if v < best_val

                            best_val := v

                            best_idx := i

            if best_idx != -1

                st.break_val := best_val

                st.break_idx := best_idx

// --- Helper: Label Logic ---

is_bottom_label(string txt) =>

    str.contains(txt, "LL") or str.contains(txt, "HL")

method push_stack(label[] arr, label lbl) =>

    merged = false

    if array.size(arr) > 0

        check_limit = math.min(20, array.size(arr))

        for i = 1 to check_limit

            idx = array.size(arr) - i

            h_lbl = array.get(arr, idx)

            if label.get_x(h_lbl) == label.get_x(lbl)

                t_hist = label.get_text(h_lbl)

                t_new = label.get_text(lbl)

                hist_is_bottom = is_bottom_label(t_hist)

                new_is_bottom = is_bottom_label(t_new)

                if hist_is_bottom == new_is_bottom

                    if not str.contains(t_hist, t_new)

                        label.set_text(h_lbl, t_hist + "-" + t_new)

                    label.delete(lbl)

                    merged := true

                    break

    if not merged

        array.push(arr, lbl)

