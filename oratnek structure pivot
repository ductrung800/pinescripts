atrx_from_sma50  = (na(atrx_sma50) or atrx_sma50 == 0 or na(atr) or atr <= 0) ? na : (gain_from_ma_pct / atr_pct_daily)

cond_11 = show_atrx_dots and atrx_from_sma50 >= atrx_lvl_11

