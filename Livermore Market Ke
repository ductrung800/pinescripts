color phaseShade = regime == 0 ? na : phasePaused ? color.new(pauseColour, 88) : regime == 1 ? color.new(upColour, 91) : color.new(downColour, 91)
bgcolor(showBackground ? phaseShade : na, title="Livermore Trend Phases")
