if nx_showDangerMarker and nx_freshDanger
    label.new(bar_index, high, nx_danger == 3 ? "D!" : "D", color=nx_danger == 3 ? color.maroon : color.orange, textcolor=color.white, style=label.style_label_down, size=size.tiny, tooltip=nx_dangerReason)

// Historical fixed pivot dashes: created ONLY on confirmed transitions.
var array<line> pivotLines = array.new_line()
if closeConfirmed and showPivots and newPivotKind != 0 and not na(newPivotPrice)
    color c = newPivotKind == 1 ? color.orange : color.rgb(63, 123, 210)
    line pivotLine = line.new(bar_index, newPivotPrice, bar_index + 18, newPivotPrice, color=c, width=1, style=line.style_dashed)
    array.push(pivotLines, pivotLine)
    if array.size(pivotLines) > maxHistoricalLines
