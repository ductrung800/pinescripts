// ── Helpers ──────────────────────────────────────────────────────────────────
f_position(string s) =>
    switch s
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

f_text_size(string s) =>
    switch s
        "Tiny" => size.tiny
        "Small" => size.small
        "Large" => size.large
        "Huge" => size.huge
        => size.normal

f_money(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

// Six original columns (left-to-right): Sec Rally, Nat Rally, Uptrend,
// Downtrend, Nat Reaction, Sec Reaction.
// Column assignment during recoveries is an interpretation, NOT a verbatim
// transcription of every case in Livermore's handwritten Market Key.
const int COL_SR = 0
const int COL_NR = 1
const int COL_UP = 2
const int COL_DN = 3
const int COL_NREACT = 4
const int COL_SREACT = 5

// ── Volatility and moving averages ───────────────────────────────────────────
float atr = ta.atr(atrLength)
float ema10 = ta.ema(close, 10)
float ema21 = ta.ema(close, 21)
float sma50 = ta.sma(close, 50)
float sma200 = ta.sma(close, 200)
// Previous COMPLETED weekly SMA10: deliberately use [1] with lookahead_on.
// Using the current developing weekly average on a Daily chart would repaint.
float confirmed10W = request.security(syminfo.tickerid, "W", ta.sma(close, 10)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float dynamicS = thresholdMode == "ATR" ? atr * atrMultiple : thresholdMode == "Percent" ? close * percentMove / 100.0 : fixedPoints
dynamicS := math.max(nz(dynamicS, syminfo.mintick), syminfo.mintick)

plot(showMAs ? ema10 : na, "10 EMA", color=#3BAEC2, linewidth=1)
plot(showMAs ? ema21 : na, "21 EMA", color=#567C46, linewidth=2)
plot(showMAs ? sma50 : na, "50 SMA", color=#BD4B47, linewidth=2)
plot(showMAs and showLongMA ? sma200 : na, "200 SMA", color=#8847C8, linewidth=2)

// ── State machine ────────────────────────────────────────────────────────────
// regime persists through pauses; phasePaused identifies the counter-trend swing.
// trendExtreme is the highest confirmed close in an active up-leg (lowest in down).
// pauseExtreme is the counter-trend extreme while paused.
// frozenS is locked when the leg/pause begins, avoiding ATR-driven level drift.
var int regime = 0
var bool phasePaused = false
var int ledgerColumn = na
var float trendExtreme = na
var float pauseExtreme = na
var float frozenS = na
var float supportPivot = na
var float resistancePivot = na
var float priorNaturalRally = na
var float priorNaturalReaction = na
var float upStartPrice = na
var int upStartTime = na

// New-bar events reset every execution; events only become true on CLOSED bars.
bool newUp = false
bool newDown = false
bool pauseUp = false
bool pauseDown = false
bool resumeUp = false
bool resumeDown = false
float newPivotPrice = na
int newPivotKind = 0 // +1 pivotal resistance, -1 pivotal support
bool closeConfirmed = barstate.isconfirmed
int oldColumn = ledgerColumn

if closeConfirmed and bar_index >= seedBars and not na(sma50)
    if regime == 0
        // SMA50 is used ONLY to initialize the ledger, never to override Market Key.
        regime := close >= sma50 ? 1 : -1
        phasePaused := false
        ledgerColumn := regime == 1 ? COL_UP : COL_DN
        trendExtreme := close
        frozenS := dynamicS
        if regime == 1
            upStartPrice := close
            upStartTime := time
    else if regime == 1
        // Test the previously established structural reversal level BEFORE any
        // current-bar pivot updates: a falling bar cannot move its own stop.
        float reversalDown = na(supportPivot) ? trendExtreme - fallbackMultiple * frozenS : supportPivot - confirmFraction * frozenS
        if close <= reversalDown
            newDown := true
            regime := -1
            phasePaused := false
            ledgerColumn := COL_DN
            trendExtreme := close
            pauseExtreme := na
            frozenS := dynamicS
            supportPivot := na
            resistancePivot := na
            priorNaturalRally := na
            priorNaturalReaction := na
        else if phasePaused
            pauseExtreme := math.min(pauseExtreme, close)
            ledgerColumn := not na(priorNaturalReaction) and pauseExtreme >= priorNaturalReaction ? COL_SREACT : COL_NREACT
            if close >= pauseExtreme + frozenS
                resumeUp := true
                phasePaused := false
                supportPivot := pauseExtreme
                priorNaturalReaction := pauseExtreme
                newPivotPrice := pauseExtreme
                newPivotKind := -1
                trendExtreme := close
                frozenS := dynamicS
                if not na(resistancePivot) and close > resistancePivot
                    ledgerColumn := COL_UP
                else if na(priorNaturalRally) or close > priorNaturalRally
                    ledgerColumn := COL_NR
                else
                    ledgerColumn := COL_SR
                priorNaturalRally := math.max(nz(priorNaturalRally, close), close)
        else
            trendExtreme := math.max(trendExtreme, close)
            if not na(resistancePivot) and close > resistancePivot
                ledgerColumn := COL_UP
            if close <= trendExtreme - frozenS
                pauseUp := true
                phasePaused := true
                pauseExtreme := close
                resistancePivot := trendExtreme
                newPivotPrice := trendExtreme
                newPivotKind := 1
                ledgerColumn := not na(priorNaturalReaction) and close >= priorNaturalReaction ? COL_SREACT : COL_NREACT
                frozenS := dynamicS
    else
        float reversalUp = na(resistancePivot) ? trendExtreme + fallbackMultiple * frozenS : resistancePivot + confirmFraction * frozenS
        if close >= reversalUp
            newUp := true
            regime := 1
            phasePaused := false
            ledgerColumn := COL_UP
            trendExtreme := close
            pauseExtreme := na
            frozenS := dynamicS
            supportPivot := na
            resistancePivot := na
            priorNaturalRally := na
            priorNaturalReaction := na
            upStartPrice := close
            upStartTime := time
        else if phasePaused
            pauseExtreme := math.max(pauseExtreme, close)
            ledgerColumn := not na(priorNaturalRally) and pauseExtreme <= priorNaturalRally ? COL_SR : COL_NR
            if close <= pauseExtreme - frozenS
                resumeDown := true
                phasePaused := false
                resistancePivot := pauseExtreme
                priorNaturalRally := pauseExtreme
                newPivotPrice := pauseExtreme
                newPivotKind := 1
                trendExtreme := close
                frozenS := dynamicS
                if not na(supportPivot) and close < supportPivot
                    ledgerColumn := COL_DN
                else if na(priorNaturalReaction) or close < priorNaturalReaction
                    ledgerColumn := COL_NREACT
                else
                    ledgerColumn := COL_SREACT
                priorNaturalReaction := math.min(nz(priorNaturalReaction, close), close)
        else
            trendExtreme := math.min(trendExtreme, close)
            if not na(supportPivot) and close < supportPivot
                ledgerColumn := COL_DN
            if close >= trendExtreme + frozenS
                pauseDown := true
                phasePaused := true
                pauseExtreme := close
                supportPivot := trendExtreme
                newPivotPrice := trendExtreme
                newPivotKind := -1
                ledgerColumn := not na(priorNaturalRally) and close <= priorNaturalRally ? COL_SR : COL_NR
                frozenS := dynamicS

// ── Ledger: one entry per new meaningful confirmed close ─────────────────────
// Same-column entries advance only on a fresh extreme; other bars are skipped.
var array<int> ledgerDates = array.new_int()
var array<int> ledgerCols = array.new_int()
var array<float> ledgerPrices = array.new_float()
var array<int> ledgerPivots = array.new_int()
var float lastLedgerClose = na

if closeConfirmed and regime != 0 and not na(ledgerColumn)
    if newPivotKind != 0 and array.size(ledgerPivots) > 0
        array.set(ledgerPivots, 0, newPivotKind)
    bool risingColumn = ledgerColumn == COL_SR or ledgerColumn == COL_NR or ledgerColumn == COL_UP
    bool changedColumn = na(oldColumn) or ledgerColumn != oldColumn
    bool freshExtreme = risingColumn ? (na(lastLedgerClose) or close > lastLedgerClose) : (na(lastLedgerClose) or close < lastLedgerClose)
    if changedColumn or freshExtreme
        array.unshift(ledgerDates, time)
        array.unshift(ledgerCols, ledgerColumn)
        array.unshift(ledgerPrices, close)
        array.unshift(ledgerPivots, 0)
        lastLedgerClose := close
        if array.size(ledgerDates) > 60
            array.pop(ledgerDates)
            array.pop(ledgerCols)
            array.pop(ledgerPrices)
            array.pop(ledgerPivots)

// ── Key levels and NEXT decision threshold ──────────────────────────────────
float trendEnd = regime == 1 ? (na(supportPivot) ? trendExtreme - fallbackMultiple * frozenS : supportPivot - confirmFraction * frozenS) : regime == -1 ? (na(resistancePivot) ? trendExtreme + fallbackMultiple * frozenS : resistancePivot + confirmFraction * frozenS) : na
float resumeLevel = phasePaused ? (regime == 1 ? pauseExtreme + frozenS : pauseExtreme - frozenS) : na
float keyLevel = phasePaused ? resumeLevel : trendEnd
string keyMeaning = regime == 0 ? "WARM-UP" : phasePaused ? (regime == 1 ? "UP RESUMES" : "DOWN RESUMES") : (regime == 1 ? "UP TREND ENDS" : "DOWN TREND ENDS")
float upTrendGain = regime == 1 and not na(upStartPrice) and upStartPrice != 0 ? (close / upStartPrice - 1.0) * 100.0 : na
float extensionATR = not na(atr) and atr > 0 and not na(sma50) ? (close - sma50) / atr : na
bool dailyContextOK = timeframe.isdaily and regime == 1 and not phasePaused and not na(confirmed10W) and close > sma50 and close > confirmed10W and not na(extensionATR) and extensionATR <= maxATRextension


// ═══ SHARED NOW DANGER / FOUR-PILLAR ENGINE v1.2.0 ═════════════════════════
// Source formulas: NOW Tech XCheck v11.3.0ca (scores are not reweighted).
// Signal interpretation is new and independent from Livermore / IBD states.
nx_clamp(float v) => math.max(0.0, math.min(100.0, v))

nx_superichi_avg(float src, int length, float mult) =>
    float atrv = ta.atr(length) * mult
    float upb = hl2 + atrv
    float dnb = hl2 - atrv
    float upper = 0.0
    float lower = 0.0
    int os = 0
    float max_v = 0.0
    float min_v = 0.0
    upper := src[1] < nz(upper[1], upb) ? math.min(upb, nz(upper[1], upb)) : upb
    lower := src[1] > nz(lower[1], dnb) ? math.max(dnb, nz(lower[1], dnb)) : dnb
    os := src > upper ? 1 : src < lower ? 0 : nz(os[1])
    float spt = os == 1 ? lower : upper
    max_v := ta.cross(src, spt) ? math.max(src, nz(max_v[1], src)) : os == 1 ? math.max(src, nz(max_v[1], src)) : spt
    min_v := ta.cross(src, spt) ? math.min(src, nz(min_v[1], src)) : os == 0 ? math.min(src, nz(min_v[1], src)) : spt
    math.avg(max_v, min_v)

// Landry + SuperIchi + SQN (Trend Quality)
nx_closeHigh50 = ta.highest(close, 50)
nx_landry65 = ta.ema(close, 65)
nx_landryScore = close >= nx_closeHigh50 * 0.95 ? 100.0 : close >= nx_closeHigh50 * 0.90 ? 65.0 : close >= nx_landry65 ? 45.0 : 20.0
nx_sqnRet = close / nz(close[1], close) - 1.0
nx_sqnDev = ta.stdev(nx_sqnRet, 100)
nx_sqnSma = ta.sma(nx_sqnRet, 100)
nx_sqnVal = nx_sqnSma * math.sqrt(100) / math.max(nx_sqnDev, 0.0001)
nx_sqnScore = nx_clamp(50.0 + nx_sqnVal * 22.0)
nx_tenkan = nx_superichi_avg(close, 9, 2.0)
nx_kijun = nx_superichi_avg(close, 26, 4.0)
nx_senkouA = math.avg(nx_kijun, nx_tenkan)
nx_senkouB = nx_superichi_avg(close, 52, 6.0)
nx_cloudTop = math.max(nx_senkouA[26], nx_senkouB[26])
nx_cloudBot = math.min(nx_senkouA[26], nx_senkouB[26])
nx_tkBull = nx_tenkan > nx_kijun
nx_ichiScore = close > nx_cloudTop and nx_tkBull ? 100.0 : close > nx_cloudTop ? 75.0 : close >= nx_cloudBot ? 50.0 : close < nx_cloudBot and not nx_tkBull ? 10.0 : 30.0
nx_trendScore = nx_clamp(nx_landryScore * 0.35 + nx_sqnScore * 0.40 + nx_ichiScore * 0.25)

// Raschke 3/10 + 2-ROC + Williams %R (Momentum Timing)
nx_r310 = ta.sma(close, 3) - ta.sma(close, 10)
nx_r310Signal = ta.sma(nx_r310, 16)
nx_r310Up = ta.crossover(nx_r310, nx_r310Signal)
nx_r310Down = ta.crossunder(nx_r310, nx_r310Signal)
nx_r310Score = nx_r310Up ? 100.0 : nx_r310Down ? 0.0 : nx_r310 > nx_r310Signal ? (nx_r310 > nx_r310[1] ? 82.0 : 68.0) : (nx_r310 > nx_r310[1] ? 42.0 : 18.0)
nx_roc2 = close - close[2]
nx_rocHigh = nx_roc2 > ta.highest(nx_roc2[1], 30) and close > high[1]
nx_rocLow = nx_roc2 < ta.lowest(nx_roc2[1], 30) and close < low[1]
nx_recentBull = math.sum(nx_rocHigh ? 1 : 0, 20) > 0
nx_recentBear = math.sum(nx_rocLow ? 1 : 0, 20) > 0
nx_rocScore = nx_rocHigh ? 100.0 : nx_rocLow ? 0.0 : nx_recentBull ? 78.0 : nx_recentBear ? 22.0 : nx_roc2 > nx_roc2[1] ? 62.0 : 38.0
nx_wprHigh = ta.highest(high, 14)
nx_wprLow = ta.lowest(low, 14)
nx_wpr = 100.0 * (close - nx_wprHigh) / math.max(nx_wprHigh - nx_wprLow, 0.0001)
nx_bearDiv = high >= ta.highest(high, 20)[1] and nx_wpr < -20 and ta.highest(nx_wpr, 20) >= -20
nx_bullDiv = low <= ta.lowest(low, 20)[1] and nx_wpr > -80 and ta.lowest(nx_wpr, 20) <= -80
nx_wprScore = nx_bullDiv ? 78.0 : nx_bearDiv ? 22.0 : nx_wpr >= -20 ? 82.0 : nx_wpr <= -80 ? 18.0 : nx_clamp(100.0 + nx_wpr)
nx_momScore = nx_clamp(nx_r310Score * 0.50 + nx_rocScore * 0.30 + nx_wprScore * 0.20)

// Elder Force Index (Participation)
nx_efi = ta.ema(ta.change(close) * volume, 13)
nx_efiBase = ta.ema(math.abs(ta.change(close) * volume), 13)
nx_efiRatio = nx_efiBase > 0 ? nx_efi / nx_efiBase : 0.0
nx_partScore = nx_clamp(50.0 + nx_efiRatio * 28.0)

// BB fully contained in KC + direction of released momentum (Expansion)
nx_basis = ta.sma(close, 20)
nx_bbDev = 2.0 * ta.stdev(close, 20)
nx_kcTr = ta.sma(ta.tr, 20)
nx_highSqz = nx_basis - nx_bbDev >= nx_basis - nx_kcTr and nx_basis + nx_bbDev <= nx_basis + nx_kcTr
nx_midSqz = not nx_highSqz and nx_basis - nx_bbDev >= nx_basis - nx_kcTr * 1.5 and nx_basis + nx_bbDev <= nx_basis + nx_kcTr * 1.5
nx_lowSqz = not nx_highSqz and not nx_midSqz and nx_basis - nx_bbDev >= nx_basis - nx_kcTr * 2.0 and nx_basis + nx_bbDev <= nx_basis + nx_kcTr * 2.0
nx_noSqz = not nx_highSqz and not nx_midSqz and not nx_lowSqz
nx_sqzMom = ta.linreg(close - math.avg(math.avg(ta.highest(high, 20), ta.lowest(low, 20)), nx_basis), 20, 0)
nx_sqzRelease = nx_noSqz and not nx_noSqz[1]
nx_expScore = nx_highSqz ? 48.0 : nx_midSqz ? 42.0 : nx_lowSqz ? 50.0 : nx_sqzRelease ? (nx_sqzMom > 0 ? 92.0 : 18.0) : nx_sqzMom > 0 ? (nx_sqzMom > nx_sqzMom[1] ? 84.0 : 70.0) : (nx_sqzMom > nx_sqzMom[1] ? 42.0 : 20.0)
// Exact Technical Cross-Check Four-Pillar total weights:
nx_techHealth = nx_clamp(nx_trendScore * 0.35 + nx_momScore * 0.30 + nx_partScore * 0.15 + nx_expScore * 0.20)
nx_setupReady = nx_clamp(nx_trendScore * 0.15 + nx_momScore * 0.35 + nx_partScore * 0.20 + nx_expScore * 0.30)
if nx_trendScore < 35
    nx_setupReady := math.min(nx_setupReady, 35.0)

// Selective Trading Mindwheel danger evidence; independent families, not a 33-item sum.
nx_range = high - low
nx_closeLoc = nx_range > 0 ? 100.0 * (close - low) / nx_range : 50.0
nx_weakClose = nx_closeLoc <= nx_closeLowPct
nx_bearBodyATRx = atr > 0 ? math.max(open - close, 0.0) / atr : 0.0
nx_shock = close < open and nx_bearBodyATRx >= nx_shockATRx and nx_weakClose
nx_volMean = ta.sma(volume, 20)
nx_heavyVol = not na(volume) and not na(nx_volMean) and nx_volMean > 0 and volume >= nx_volMean * nx_heavyVolX
nx_sellClimax = nx_weakClose and nx_heavyVol and close < close[1]
// Post-shock is confirmation-only memory, not a Livermore trend transition.
// The initiating shock bar is counted as age 0; age 1..N are subsequent bars.
var int nx_lastConfirmedShock = na
var float nx_shockMidpoint = na
if barstate.isconfirmed and nx_shock
    nx_lastConfirmedShock := bar_index
    nx_shockMidpoint := (open + close) * 0.5
nx_shockAge = na(nx_lastConfirmedShock) ? na : bar_index - nx_lastConfirmedShock
nx_shockRepair = not na(nx_shockMidpoint) and close > nx_shockMidpoint and close > ema21
nx_postShock = nx_enabled and nx_postShockEnabled and not na(nx_shockAge) and nx_shockAge >= 1 and nx_shockAge <= nx_postShockBars and not nx_shockRepair
nx_postShockStart = barstate.isconfirmed and nx_postShock and not nx_postShock[1]
nx_outsideRev = high > high[1] and low < low[1] and close < open and nx_weakClose
nx_threeLows = low < low[1] and low[1] < low[2] and low[2] < low[3]
nx_belowThreeLows = close < ta.lowest(low[1], 3)
nx_pivot = ta.pivotlow(low, nx_pivotLen, nx_pivotLen)
var float nx_confirmedSwingLow = na
if not na(nx_pivot) and barstate.isconfirmed
    nx_confirmedSwingLow := nx_pivot
nx_swingFail = not na(nx_confirmedSwingLow[1]) and close < nx_confirmedSwingLow[1] and close[1] >= nx_confirmedSwingLow[1]
nx_benchmark = request.security(nx_rsSymbol, timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
nx_relative = not na(nx_benchmark) and nx_benchmark != 0 ? close / nx_benchmark : na
nx_selfBenchmark = syminfo.ticker == "SPY"
nx_rsWeak = not nx_selfBenchmark and not na(nx_relative[7]) and nx_relative < nx_relative[7] and nx_relative < nx_relative[1]
nx_MAWeak = close < ema21 or close < sma50
nx_weeklyWeak = not na(confirmed10W) and close < confirmed10W // prior FINISHED weekly 10-SMA
nx_priceFamily = nx_shock or nx_outsideRev or nx_swingFail or nx_belowThreeLows or nx_MAWeak
nx_sellingFamily = nx_sellClimax or (nx_heavyVol and close < open) or nx_partScore < 42
nx_technicalFamily = nx_momScore < 45 or nx_trendScore < 45 or nx_rsWeak or nx_rocLow or nx_bearDiv
nx_families = (nx_priceFamily ? 1 : 0) + (nx_sellingFamily ? 1 : 0) + (nx_technicalFamily ? 1 : 0)
// Previous bar's threshold represents the pre-candle structural reference.
// A confirmed newDown automatically changes 'regime', so do not compare with the new DOWN level.
nx_previousTrendEnd = trendEnd[1]
nx_livePivotBreach = not barstate.isconfirmed and regime == 1 and not na(nx_previousTrendEnd) and close <= nx_previousTrendEnd
nx_unexplainedBreach = barstate.isconfirmed and regime == 1 and not na(nx_previousTrendEnd) and close <= nx_previousTrendEnd
nx_newConfirmedDown = newDown and barstate.isconfirmed
nx_structuralThreat = nx_livePivotBreach or nx_unexplainedBreach or nx_newConfirmedDown
nx_dangerBase = regime == 0 ? 0 : nx_structuralThreat or regime == -1 ? 3 : nx_shock or (nx_swingFail and nx_sellingFamily) or (nx_families >= 3 and (nx_swingFail or nx_belowThreeLows or nx_weeklyWeak)) ? 2 : nx_families >= 2 or nx_sellClimax or nx_outsideRev or nx_weeklyWeak ? 1 : 0
nx_dangerRaw = nx_postShock ? math.max(nx_dangerBase, 2) : nx_dangerBase
nx_danger = nx_enabled ? nx_dangerRaw : 0
nx_dangerLabel = nx_danger == 3 ? (nx_livePivotBreach ? "CRITICAL · LIVE PIVOT BREACH" : nx_newConfirmedDown ? "CRITICAL · DOWN CONFIRMED" : nx_unexplainedBreach ? "CRITICAL · PIVOT/STATE MISMATCH" : "CRITICAL · DOWN TREND") : nx_danger == 2 ? (nx_postShock and nx_dangerBase < 2 ? "DANGER · POST-SHOCK WATCH" : "DANGER · STRUCTURAL DAMAGE") : nx_danger == 1 ? "CAUTION · DETERIORATION" : "NORMAL · NO MAJOR WARNING"
nx_dangerReason = nx_livePivotBreach ? "Forming price is below PRIOR closing reversal level; confirm at bar close." : nx_unexplainedBreach ? "Confirmed close breached prior flip level without expected reversal; audit state." : nx_newConfirmedDown ? "Confirmed Livermore downside reversal on this bar." : nx_shock ? "Bear body " + str.tostring(nx_bearBodyATRx, "#.1") + " ATR; weak close " + str.tostring(nx_closeLoc, "#") + "% of range." : nx_postShock and nx_dangerBase < 3 ? "POST-SHOCK · confirmed bear shock " + str.tostring(nx_shockAge) + " bars ago; await repair above EMA21 and shock midpoint." : nx_swingFail ? "Confirmed swing-low support broke; validate existing stops." : nx_sellClimax ? "Heavy-volume lower close near the session low." : nx_danger > 0 ? "Price/volume/technical evidence is deteriorating; check original panels." : "No significant danger family currently confirmed."
nx_dangerPlan = nx_danger >= 3 ? "NO NEW RISK; inspect Master OS EXIT/PROTECT now." : nx_danger == 2 ? "NO NEW RISK; Master OS PROTECT/TRIM review." : nx_danger == 1 ? "WAIT for repair / avoid chase; reassess ownership." : "Evidence neutral; entries still require Master OS permission."
nx_freshDanger = barstate.isconfirmed and nx_enabled and nx_danger >= 2 and nz(nx_danger[1], 0) < 2
nx_freshCritical = barstate.isconfirmed and nx_enabled and nx_danger == 3 and nz(nx_danger[1], 0) < 3

// ═══ v1.2 · Diagnostic witness layer (does NOT alter nx_danger) ═══════════
// Display current warning reasons individually: signals can overlap and are NOT
// independent votes. Confirmed bar status is supplied separately in main desk.
nx_diagNearLow = nx_weakClose and close < open
nx_diagLowerLows = nx_threeLows or nx_belowThreeLows
nx_diagMABreak = close < ema21 or close < sma50
nx_diagVolSell = nx_sellClimax or (nx_heavyVol and close < open)
nx_diagRS = nx_rsWeak
nx_diagMomentum = nx_momScore < 45 or nx_rocLow or nx_bearDiv
nx_diagExhaust = nx_bearDiv or nx_outsideRev
nx_diagCount = (nx_shock ? 1 : 0) + (nx_swingFail ? 1 : 0) + (nx_diagNearLow ? 1 : 0) + (nx_diagLowerLows ? 1 : 0) + (nx_diagMABreak ? 1 : 0) + (nx_diagVolSell ? 1 : 0) + (nx_diagRS ? 1 : 0) + (nx_diagMomentum ? 1 : 0) + (nx_diagExhaust ? 1 : 0)
// ADX/DI evidence from the existing XCheck method; NOT part of TECH HEALTH.
[nx_diagDIplus, nx_diagDIminus, nx_diagADX] = ta.dmi(nx_diagADXLength, nx_diagADXSmooth)
nx_diagBearTrend = nx_diagADX >= 25 and nx_diagDIminus > nx_diagDIplus
// Weekly Miner DLB v11.3 baseline uses 21=>RSI21, Stoch13, K8, D8.
// Request only the last completed weekly bar to avoid developing-week repaint.
nx_dlbWK(float src) =>
    float r = ta.rsi(src, 21)
    float lo = ta.lowest(r, 13)
    float hi = ta.highest(r, 13)
    float k = ta.sma((r - lo) / math.max(hi - lo, 0.0001) * 100.0, 8)
    float d = ta.sma(k, 8)
    [k[1], d[1]]
[nx_diagWK_K, nx_diagWK_D] = request.security(syminfo.tickerid, "W", nx_dlbWK(close), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
nx_diagWKTopping = nx_diagWK_D > 75 and nx_diagWK_K < 75
nx_diagWKBull = nx_diagWK_D > 75 and nx_diagWK_K >= 75
nx_diagWKBearing = nx_diagWK_D < 25 and nx_diagWK_K <= 25
nx_diagWeakTrend = nx_diagBearTrend or nx_diagWKTopping or nx_diagWKBearing
nx_diagPriceRead = (nx_shock ? "BEAR SHOCK · " : "") + (nx_swingFail ? "SWING LOW FAILED · " : "") + (nx_diagLowerLows ? "LOWER LOWS · " : "") + (nx_diagMABreak ? "MA BELOW · " : "")
nx_diagSellRead = nx_diagVolSell ? "HEAVY-VOLUME SELLING" : nx_diagNearLow ? "CLOSE NEAR LOW" : "No major selling trigger"
nx_diagMomRead = nx_diagMomentum ? "MOMENTUM WEAK" : "Momentum not below threshold"
nx_diagRSRead = nx_diagRS ? "RELATIVE STRENGTH FALLING" : "No 7-bar RS warning"
nx_diagCycleRead = nx_diagWKTopping ? "PRIOR WEEK: DLB TOPPING" : nx_diagWKBearing ? "PRIOR WEEK: EMBEDDED BEAR" : nx_diagWKBull ? "PRIOR WEEK: EMBEDDED BULL" : "PRIOR WEEK: NEUTRAL"

// Provisional intrabar states are dashboard-only; alerts remain confirmed-close.

