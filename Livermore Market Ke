// ── v1.2.4 collision-safe single-table, read-first presentation ──
// No modification to Livermore states, Danger calculations, XCheck formulas or screeners.
f_unifiedRow(table tb, int r, string key, string value, color bg, color keyFg, color valFg, string sz) =>
    table.cell(tb, 0, r, key, bgcolor=bg, text_color=keyFg, text_size=f_text_size(sz), text_halign=text.align_left)
    table.cell(tb, 1, r, value, bgcolor=bg, text_color=valFg, text_size=f_text_size(sz), text_halign=text.align_left)

f_renderUnified(table tb) =>
    table.clear(tb, 0, 0, 1, 26)
    if showBrief
        bool lightDesk = readoutTheme == "Light"
        color bg = lightDesk ? color.rgb(237, 241, 247) : color.rgb(17, 29, 46)
        color fg = lightDesk ? color.rgb(23, 35, 51) : color.rgb(234, 240, 248)
        color headBg = lightDesk ? color.rgb(207, 219, 235) : color.rgb(29, 47, 70)
        color keyFg = lightDesk ? color.rgb(16, 78, 114) : color.aqua
        color dangerBg = nx_danger == 3 ? color.rgb(153, 38, 50) : nx_danger == 2 ? color.rgb(178, 75, 29) : nx_danger == 1 ? color.rgb(142, 105, 24) : color.rgb(34, 106, 72)
        color stateBg = nx_livePivotBreach ? color.maroon : regime == 0 ? color.gray : phasePaused ? pauseColour : regime == 1 ? upColour : downColour
        string stateText = nx_livePivotBreach ? "UP · PROVISIONAL BREACH" : regime == 0 ? "WARM-UP" : regime == 1 ? (phasePaused ? "UP · PAUSED" : "UP · ACTIVE") : phasePaused ? "DOWN · PAUSED" : "DOWN · ACTIVE"
        string trendDescription = regime == 0 ? "Trend calculation warming up." : nx_livePivotBreach ? "Previously confirmed uptrend; price has provisionally breached its reversal level." : regime == 1 and phasePaused ? "Established uptrend is pausing, not yet reversed." : regime == 1 ? "Confirmed uptrend; monitor pivotal protection." : phasePaused ? "Downtrend is pausing; rebound not yet a confirmed uptrend." : "Confirmed downtrend; rallies have not repaired structure."
        string riskDescription = nx_livePivotBreach ? "Price is through the key reversal level intrabar; check the completed close." : nx_newConfirmedDown ? "Most recent completed bar confirmed a downside Livermore reversal." : nx_shock ? "Bearish body " + str.tostring(nx_bearBodyATRx, "#.1") + " ATR, close in bottom " + str.tostring(nx_closeLoc, "#") + "% of range." : nx_postShock ? "Recent bearish shock still under review; price has not repaired." : nx_swingFail ? "Confirmed swing-low support has broken." : nx_sellClimax ? "Heavy-volume selling with a lower close near the session low." : nx_danger > 0 ? "Technical deterioration; inspect structure, momentum and selling pressure." : "No major danger family currently active."
        string actionText = nx_danger >= 2 ? "NO NEW RISK. Review stops; ask Master OS to evaluate PROTECT / TRIM / EXIT." : nx_danger == 1 ? "WAIT / WATCH. Avoid chasing and verify Master OS permission." : "WATCH. Master OS alone authorises any entry or exit."
        string nextLevelText = phasePaused ? "Resume after confirmed CLOSE " + (regime == 1 ? "> " : "< ") + f_money(resumeLevel) : "Reverse after confirmed CLOSE " + (regime == 1 ? "<= " : ">= ") + f_money(trendEnd)
        string repairText = nx_danger >= 2 ? "Require price structure, momentum and participation repair. " + nextLevelText : nx_danger == 1 ? "Look for easing sell pressure and support holding. " + nextLevelText : nextLevelText
        string trendState = nx_trendScore >= 80 ? "STRONG" : nx_trendScore >= 65 ? "SUPPORTIVE" : nx_trendScore >= 45 ? "MIXED" : "DAMAGED"
        string momState = nx_momScore >= 80 ? "ACCELERATING" : nx_momScore >= 65 ? "POSITIVE" : nx_momScore >= 45 ? "TRANSITION" : "DETERIORATING"
        string partState = nx_partScore >= 75 ? "STRONG BUYING" : nx_partScore >= 58 ? "ACCUMULATING" : nx_partScore >= 42 ? "MIXED" : "SELLING PRESSURE"
        string expState = nx_expScore >= 65 ? "POSITIVE EXPANSION" : nx_expScore < 35 ? "NEGATIVE EXPANSION" : "MIXED / COMPRESSING"
        string trendRead = nx_trendScore >= 65 ? "Structure, SQN and cloud support trend." : nx_trendScore >= 45 ? "Structural evidence mixed; wait for repair." : "Structure, SQN and cloud indicate damage."
        string momRead = nx_momScore >= 65 ? "3/10, 2-ROC and Williams %R support upside timing." : nx_momScore >= 45 ? "Momentum transitioning; signals incomplete." : "3/10, 2-ROC and Williams %R deteriorating."
        string partRead = nx_partScore >= 58 ? "Force Index supports buying participation." : nx_partScore >= 42 ? "Force Index mixed; conviction uncertain." : "Force Index: sellers dominate."
        string expRead = nx_expScore >= 65 ? "Expansion favours upside." : nx_expScore < 35 ? "Negative expansion / downside momentum." : "No strong positive expansion."
        string postShockText = not nx_postShockEnabled ? "Disabled" : nx_postShock ? "Active, " + str.tostring(nx_shockAge) + "/" + str.tostring(nx_postShockBars) + " bars since confirmed shock" : nx_shock and barstate.isconfirmed ? "New confirmed shock; watch begins next bar" : "Inactive"
        // Exactly one table at bottom-right, grouped for sequential reading.
        f_unifiedRow(tb, 0, "NOW LIVERMORE · DECISION DESK", stateText, headBg, fg, fg, textSizeInput)
        f_unifiedRow(tb, 1, "DANGER", nx_dangerLabel, dangerBg, color.white, color.white, textSizeInput)
        f_unifiedRow(tb, 2, "EXECUTIVE · WHAT IS HAPPENING", "TREND → RISK → ACTION", headBg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 3, "TREND", trendDescription, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 4, "WHAT IS WRONG", riskDescription, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 5, "WHAT SHOULD I DO", actionText, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 6, "WATCH NEXT", repairText, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 7, "TECHNICAL · CROSS-CHECK", "FOUR PILLARS · CONFIRMATION ONLY", headBg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 8, "TREND QUALITY · " + str.tostring(nx_trendScore, "#") + " · " + trendState, trendRead, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 9, "MOMENTUM · " + str.tostring(nx_momScore, "#") + " · " + momState, momRead, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 10, "PARTICIPATION · " + str.tostring(nx_partScore, "#") + " · " + partState, partRead, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 11, "EXPANSION · " + str.tostring(nx_expScore, "#") + " · " + expState, expRead, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 12, "OVERALL TECH HEALTH", str.tostring(nx_techHealth, "#") + "/100 · " + (nx_techHealth < 45 ? "TECH DAMAGE" : nx_techHealth < 65 ? "MIXED / INCOMPLETE" : "TECHNICALLY SUPPORTIVE"), bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 13, "ADX / DIRECTION", "ADX " + str.tostring(nx_diagADX, "#") + (nx_diagDIminus > nx_diagDIplus ? " · -DI leads" : " · +DI leads") + "; strength is not direction.", bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 14, "WEEKLY CYCLE", nx_diagDLB ? nx_diagCycleRead + " · last completed week" : "Weekly DLB disabled", bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 15, "DANGER · ACTIVE EVIDENCE", "GROUPED CONDITIONS · NOT INDEPENDENT VOTES", headBg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 16, "ACTIVE WARNINGS", str.tostring(nx_diagCount) + " selected conditions; not equivalent to original 33-signal total", bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 17, "BEARISH SHOCK", nx_shock ? "Abnormal bearish body with weak close; price character changed." : "No current shock by configured thresholds.", bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 18, "PRICE / STRUCTURE", nx_diagPriceRead == "" ? "No active structure diagnostic." : nx_diagPriceRead + " · verify confirmed pivots.", bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 19, "SELLING / VOLUME", nx_diagSellRead + ". Weak close/volume strengthen the warning.", bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 20, "MOMENTUM / RS", nx_diagMomRead + " · " + nx_diagRSRead + ".", bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 21, "DANGER PLAN", actionText, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 22, "LEVELS · NEXT FLIP", "CONFIRMED CLOSE REQUIRED", headBg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 23, "RESUME", f_money(resumeLevel) + " · " + (phasePaused ? "active resumption trigger" : "reference level"), bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 24, "TREND FLIP", f_money(trendEnd) + " · " + nextLevelText, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 25, "POST-SHOCK", postShockText, bg, keyFg, fg, textSizeInput)
        f_unifiedRow(tb, 26, "NOW CONTEXT", showContext ? (not timeframe.isdaily ? "1D chart needed for Daily context checks" : dailyContextOK ? "SMA50 / 10-week SMA / extension context passes" : "One or more entry-context gates fail") : "Context hidden", bg, keyFg, fg, textSizeInput)

// v1.2.4: Create ONLY the table(s) for the selected mode.
// TradingView table.clear() empties cells, but the table object still occupies
// its anchor; the v1.2.3 preallocated bottom-right tables could hide each other.
// Inputs re-execute the script, so conditional `var` initialization is safe.
bool modeUnified = showBrief and readoutMode == "Unified Vertical"
bool modeAll = showBrief and readoutMode == "All Tables"
bool modeSingle = showBrief and not modeUnified and not modeAll
var table unifiedTable = modeUnified ? table.new(position.bottom_right, 2, 27, border_width=1) : na
var table executiveTable = modeAll ? table.new(position.top_right, 2, 19, border_width=1) : na
var table technicalTable = modeAll ? table.new(position.middle_right, 2, 19, border_width=1) : na
var table dangerTable = modeAll ? table.new(position.bottom_right, 2, 19, border_width=1) : na
var table briefing = modeSingle ? table.new(f_position(briefPositionInput), 2, 19, border_width=1) : na
if barstate.islast
    if modeUnified
        f_renderUnified(unifiedTable)
    else if modeAll
        f_renderReadout(executiveTable, "Executive")
        f_renderReadout(technicalTable, "Technical Detail")
        f_renderReadout(dangerTable, "Danger Detail")
    else if modeSingle
        f_renderReadout(briefing, readoutMode)

// Optional single, compact diagnostic table: not another execution panel.
// Only instantiate diagnostics when actually visible, and never stack them on
// an occupied readout/ledger anchor. Unified and All Tables already contain them.
bool diagRequested = nx_showDiagnostics and nx_enabled and modeSingle
bool diagSlotFree = nx_diagPosition != briefPositionInput and (not showLedger or (nx_diagPosition != ledgerPositionInput and nx_diagPosition != "Bottom Left"))
var table nx_diagTable = diagRequested and diagSlotFree ? table.new(f_position(nx_diagPosition), 2, 9, border_width=1) : na
if barstate.islast and diagRequested and diagSlotFree
    table.clear(nx_diagTable, 0, 0, 1, 8)
    color db = color.rgb(20, 30, 44)
    color fg = color.rgb(229, 235, 242)
    table.cell(nx_diagTable, 0, 0, "NOW DANGER DETAILS", text_color=color.white, bgcolor=color.rgb(108, 37, 52), text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 0, str.tostring(nx_diagCount) + " active conditions (overlap)", text_color=color.white, bgcolor=color.rgb(108, 37, 52), text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 1, "PRICE / STRUCTURE", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 1, nx_diagPriceRead == "" ? "No current trigger" : nx_diagPriceRead, text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 2, "SELLING / VOLUME", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 2, nx_diagSellRead, text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 3, "MOMENTUM", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 3, nx_diagMomRead, text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 4, "RELATIVE STRENGTH", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 4, nx_diagRSRead, text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 5, "ADX / DIRECTION", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 5, "ADX " + str.tostring(nx_diagADX, "#") + (nx_diagDIminus > nx_diagDIplus ? " · -DI leading" : " · +DI leading") + (nx_diagBearTrend ? " · BEAR TREND" : ""), text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 6, "WEEKLY DLB", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 6, nx_diagDLB ? nx_diagCycleRead : "Hidden", text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 7, "FOUR PILLARS", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 7, "T " + str.tostring(nx_trendScore, "#") + " · M " + str.tostring(nx_momScore, "#") + " · P " + str.tostring(nx_partScore, "#") + " · E " + str.tostring(nx_expScore, "#"), text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 0, 8, "STATUS / AUTHORITY", text_color=color.aqua, bgcolor=db, text_size=f_text_size(textSizeInput))
    table.cell(nx_diagTable, 1, 8, (barstate.isconfirmed ? "CLOSED" : "FORMING") + " · Evidence only; Master OS decides", text_color=fg, bgcolor=db, text_size=f_text_size(textSizeInput))

// ── Livermore six-column ledger (chronological oldest to newest) ────────────
// Ledger never shares a table anchor with the active dashboard.
bool ledgerClash = showBrief and ((modeUnified and ledgerPositionInput == "Bottom Right") or (modeAll and (ledgerPositionInput == "Top Right" or ledgerPositionInput == "Middle Right" or ledgerPositionInput == "Bottom Right")) or (modeSingle and ledgerPositionInput == briefPositionInput))
string safeLedgerPosition = ledgerClash ? (briefPositionInput == "Bottom Left" and modeSingle ? "Bottom Center" : "Bottom Left") : ledgerPositionInput
var table ledger = showLedger ? table.new(f_position(safeLedgerPosition), 7, ledgerRows + 2, border_width=1) : na
if barstate.islast and showLedger
    color h = color.rgb(33, 52, 81)
    color b = color.rgb(22, 29, 42)
    color light = color.rgb(232, 236, 242)
    table.cell(ledger, 0, 0, "DATE", text_color=light, bgcolor=h, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 1, 0, "SEC RALLY", text_color=light, bgcolor=h, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 2, 0, "NAT RALLY", text_color=light, bgcolor=h, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 3, 0, "UPTREND", text_color=light, bgcolor=h, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 4, 0, "DOWNTREND", text_color=light, bgcolor=h, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 5, 0, "NAT REACT", text_color=light, bgcolor=h, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 6, 0, "SEC REACT", text_color=light, bgcolor=h, text_size=f_text_size(textSizeInput))
    int count = math.min(array.size(ledgerDates), ledgerRows)
    for row = 0 to ledgerRows - 1
        int idx = count - row - 1
        string d = idx >= 0 ? str.format_time(array.get(ledgerDates, idx), "yyyy-MM-dd", syminfo.timezone) : ""
        int c = idx >= 0 ? array.get(ledgerCols, idx) : -1
        float p = idx >= 0 ? array.get(ledgerPrices, idx) : na
        int marker = idx >= 0 ? array.get(ledgerPivots, idx) : 0
        table.cell(ledger, 0, row + 1, d, bgcolor=b, text_color=light, text_size=f_text_size(textSizeInput))
        for col = 0 to 5
            bool filled = c == col
            color cellBg = filled and marker != 0 ? color.rgb(216, 193, 86) : b
            color cellFg = filled and marker != 0 ? color.black : col == COL_UP ? color.rgb(93, 220, 150) : col == COL_DN ? color.rgb(242, 117, 118) : light
            table.cell(ledger, col + 1, row + 1, filled ? f_money(p) : "", bgcolor=cellBg, text_color=cellFg, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 0, ledgerRows + 1, "PIVOTS", bgcolor=h, text_color=light, text_size=f_text_size(textSizeInput))
    table.cell(ledger, 1, ledgerRows + 1, "Gold=key", bgcolor=h, text_color=light, text_size=f_text_size(textSizeInput))
    for col = 2 to 6
        table.cell(ledger, col, ledgerRows + 1, "", bgcolor=h)
// Hidden ledger has no table object to clear.

