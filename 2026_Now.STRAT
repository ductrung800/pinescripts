// Combo labels ported from StratAssist by @RickyZane85
// Additional columns (ADR, %, AS, Combo, IF, Rev, Cont) inspired by StratLab layout

// v2.5.7: Trend Participation Scan — adds explicit 2-2 continuation A/B, Trend Relay A/B scanning, and qualified continuation authority for established uptrends.
// v2.5.8 DISPLAY REFINEMENT: Playbook Boxes = Current Only / All Historical / Off. Default Current Only.
// Signal detection, grading, screener outputs and execution authority are unchanged from v2.5.7.
// Preserves v2.5.4 Holy Grail / Nirvana authority and adds three high-priority playbook families:
// (1) RECLAIM TRAP: Failed 2D→2U / Failed 2U→2D,
// (2) INSIDE REVERSAL: 2D→1→2U / 2U→1→2D, and
// (3) REVSTRAT: 1→2D→2U / 1→2U→2D.
// Each family has ARMED setup highlighting, A/B/C/X breakout quality, Screener outputs,
// v2.5.7 adds 2-2 continuation and a compact Trend Participation A/B scan (2-2, 2-1-2, 2-2-2, RT).
// Daily swing naming, and 60m execution naming. Pattern identity never overrides sponsorship/risk authority.
// Legacy detailed STRAT matrix + parity table retained as optional validation views.

// Table columns per timeframe row:
//   ADR  | %      | AS (bar sequence e.g. 3d-1-2u) | Combo (pattern name) | IF (in force ▲/▼) | Rev (failed 2) | Cont (continuity ✓)

indicator("NOW STRAT — Unified Decision Dashboard v2.5.7", "NOW STRAT Unified v2.5.8", true, max_lines_count = 10, max_labels_count = 260, max_boxes_count = 220, calc_bars_count = 500)

get_size(sz) =>
    switch sz
        'Tiny'   => size.tiny
        'Small'  => size.small
        'Normal' => size.normal
        'Large'  => size.large
        'Huge'   => size.huge
        => size.auto

// ══════════════════════════════════════════════════ INPUTS ══════════════════════════════════════════════════

var g1 = "📍 Timeframes"
y1  = input.bool(true,  "", inline="1",  group=g1)
tf1  = input.timeframe("M",   "", inline="1",  group=g1)
y2  = input.bool(true,  "", inline="1",  group=g1)
tf2  = input.timeframe("W",   "", inline="1",  group=g1)
y3  = input.bool(true,  "", inline="2",  group=g1)
tf3  = input.timeframe("D",   "", inline="2",  group=g1)
y4  = input.bool(false, "", inline="2",  group=g1)
tf4  = input.timeframe("240", "", inline="2",  group=g1)
y5  = input.bool(true,  "", inline="3",  group=g1)
tf5  = input.timeframe("60",  "", inline="3",  group=g1)
// Ultra-memory-safe combined build: M/W/D/4H/1H are the available MTF rows.
// Lower intraday rows remain disabled internally because their 20-series requests
// are redundant for a swing-trading master script and were the largest memory load.
bool y6 = false
string tf6 = "30"
bool y7 = false
string tf7 = "15"
bool y8 = false
string tf8 = "10"
bool y9 = false
string tf9 = "5"
bool y10 = false
string tf10 = "1"
bool y11 = false
string tf11 = "1W"
