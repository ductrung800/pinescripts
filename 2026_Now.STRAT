string tf12 = "1M"

var g2 = "⚙️ Calculation Method"
failed_2_method      = input.string("Either", "Failed Bar Method", options=['Open','Reclaim','Both','Either'], tooltip="Open: Failed when close opposite of open\nReclaim: Failed when inside prev range\nBoth: Must meet both\nEither: Meets either", group=g2)
ftfc_override_reclaim = input.bool(true, "FTFC Overrides Reclaim", tooltip="When all TFs agree directionally, reclaim signals are ignored.", group=g2)

var g3 = "📊 Table Display"
tfc_table          = input.bool(false, "Show Expanded STRAT Matrix (Validation)", tooltip="Optional legacy/diagnostic view. The Unified Dashboard is the default decision surface.", group=g3)
table_position     = input.string('Top Right', "Position", options=['Bottom Center','Bottom Left','Bottom Right','Middle Center','Middle Left','Middle Right','Top Center','Top Left','Top Right'], group=g3)
show_bar_col       = input.bool(true,  "Show Bar Type Column",     tooltip="Show current bar type: 1, 2U, 2D, 3", group=g3)
show_pct_col       = input.bool(true,  "Show % Column",            tooltip="% change from timeframe open to current price", group=g3)
show_as_col        = input.bool(true,  "Show AS Column",           tooltip="Bar sequence (e.g. 2u-1-3) last 3 bars", group=g3)
show_combo_col     = input.bool(true,  "Show Combo Column",        tooltip="StratAssist combo pattern name", group=g3)
show_if_col        = input.bool(true,  "Show IF Column",           tooltip="In Force — price outside prior bar range", group=g3)
show_rev_col       = input.bool(true,  "Show Rev Column",          tooltip="Reversal signal — failed 2", group=g3)
show_cont_col      = input.bool(true,  "Show Cont Column",         tooltip="Continuity — all TFs above/below open (+/-)", group=g3)
show_header_row    = input.bool(true,  "Show Header Row",          tooltip="Show column labels in first row", group=g3)

var g4 = "🎨 Styling"
