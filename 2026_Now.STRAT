bar_1_above_color = input.color(#ffeb3b, "1 Above Open",  group=g4)
bar_1_below_color = input.color(#ff9800, "1 Below Open",  group=g4)
bar_2u_color      = input.color(#4caf50, "2U",            group=g4)
bar_2d_color      = input.color(#f23645, "2D",            group=g4)
bar_f2u_color     = input.color(#f77c80, "Failed 2U",     group=g4)
bar_f2d_color     = input.color(#81c784, "Failed 2D",     group=g4)
