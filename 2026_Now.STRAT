bar_3_below_color = input.color(#801922, "3 Below Open",  group=g4)
header_bg_color   = input.color(#222222, "Header BG",     group=g4)
inside_bar_hl     = input.color(color.fuchsia, "Inside Bar Highlight", group=g4)
