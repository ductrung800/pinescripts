ftfc_dn_color          = input.color(#f23645, "", inline="FTFC", group=g5)
ftfc_nu_color          = input.color(#808080, "", inline="FTFC", group=g5)
show_transition_colors = input.bool(true,  "Highlight Failed Bar Transitions", group=g5)
show_failed_2s_chart   = input.bool(false, "Mark Failed 2s on Chart", group=g5)
f2u_shape_color        = input.color(#f77c80, "Failed 2U Chart Color", inline="F2C", group=g5)
